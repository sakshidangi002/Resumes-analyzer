# Copy this file to .env and edit. App reads .env (not this file).
# PostgreSQL (remote server: set POSTGRES_HOST to server IP)
POSTGRES_HOST=192.168.29.210
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# JWT (change in production)
SECRET_KEY=abc2025

# SMTP (simple SMTP for all emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME=HRMS

DVR_AUTOSTART=true
DVR_IP=192.168.29.181
DVR_PORT=8000
DVR_USERNAME=anilchanna
DVR_PASSWORD=test@123

# Which DVR channel is the EXIT camera (everything else = entrance/IN):
DVR_OUT_CHANNELS=4          # ← set to your checkout camera's channel number

# Monitoring-only channels (working area / sitting area). These do PERSON
# detection (YOLO11 body boxes) + name-on-face, but NEVER mark attendance.
DVR_MONITOR_CHANNELS=1,3    # ← comma-separated channel numbers of room cameras

DVR_RECOGNITION_THRESHOLD=0.4   # frontal faces score 0.5+, so this is safe

# Leave these OFF — they need a downloaded model and are only for overhead cams:
# CCTV_PERSON_TRACKING   (don't set)
# DVR_CROSSING_ENABLED   (don't set)
CCTV_MOTION_THRESHOLD=3        # lower = more sensitive; raise if noisy camera
CCTV_DETECT_MAXSIDE=800        # downscale big frames before detection = faster
CCTV_DISPLAY_IDLE_SEC=8        # stop encoding a feed 8s after last viewer
# Recognition backend. Keep arcface until every employee is re-enrolled with
# AdaFace and the CCTV calibration report approves the new thresholds.
# FACE_RECOGNITION_MODEL=adaface
FACE_RECOGNITION_MODEL=adaface

# ---- Health endpoint (T-01) -------------------------------------------------
# Two endpoints, deliberately answering different questions:
#
#   /health/live  "is this process able to serve a request?"
#                 The SUPERVISOR's restart target. Stays 200 even while
#                 /health is degraded, and that is intentional: restarting the
#                 process cannot reconnect an unplugged camera or revive a dead
#                 database. Wiring a restart to those conditions turns a
#                 visible, recoverable fault into a restart loop on top of it.
#
#   /health       "is this process actually doing its job?"
#                 Returns 503 when the database, a camera, or the attendance
#                 writer is unhealthy, with a body naming what failed. This is
#                 the MONITORING/alerting target, never the restart target.
#
# Rollback switch. HEALTH_STRICT=0 restores the pre-T-01 behaviour — /health
# returns {"status":"ok"} unconditionally, checking nothing. Use it only to rule
# the health check itself out as the cause of an incident (for example if a
# probe is producing false 503s and paging people at 3am). It is not a fix: with
# it off, a total camera outage reports as healthy. Turn it back on.
# HEALTH_STRICT=0
#
# How stale a camera's last FRAME may be before /health degrades, in seconds.
# The capture thread already forces a reconnect at CCTV_STALE_TIMEOUT (15s), so
# 60 sits comfortably past "the reconnect was tried and failed".
HEALTH_MAX_FRAME_AGE_SEC=60
#
# How long a camera may go without completing an ANALYSIS pass, in seconds.
# Deliberately far looser than frame age: the motion gate is SUPPOSED to
# suspend inference on a static scene (monitor cameras coast for
# CCTV_MONITOR_COAST_SEC=30, doorways force a pass only every
# CCTV_MAX_IDLE_SKIP_QUIET_SEC=8), and a p99 analysis cycle on this hardware is
# ~25s. An empty corridor at night is idle, not broken — a tight threshold here
# would page every night, which is how a health check gets ignored. 180 clears
# every legitimate idle path while still catching the real failure this was
# written for: camera 60 produced a 3,360-second gap (host sleep) that nothing
# detected. Do not tune this before baseline data exists (T-04).
HEALTH_MAX_INFERENCE_AGE_SEC=180
#
# Hard cap on the database probe, in seconds. A health check that blocks looks
# identical to a dead process from the supervisor's side.
HEALTH_DB_TIMEOUT_SEC=3.0
#
# Attendance-writer queue fill ratio at which /health degrades. Below 1.0 on
# purpose: at 100% the queue overflows and writes are DROPPED, so the alarm has
# to fire while there is still headroom to act.
HEALTH_QUEUE_WARN_RATIO=0.8
